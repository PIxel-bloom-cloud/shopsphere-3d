PORT=5000
# MongoDB Atlas or a local MongoDB replica-set connection
MONGO_URI=mongodb://127.0.0.1:27017/shopsphere?replicaSet=rs0
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
CLIENT_URL=http://localhost:5173
# Used only by: npm run create-admin
ADMIN_NAME=Store Administrator
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=choose_a_unique_password_at_least_12_characters
